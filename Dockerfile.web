# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files from root (frontend)
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code (everything except server)
COPY . ./

# Remove server folder (we don't need it for frontend build)
RUN rm -rf server

# Build the frontend
RUN npm run build

# Production stage - serve with nginx
FROM nginx:alpine AS production

# Install curl for health check
RUN apk add --no-cache curl

# Config via template: envsubst em /docker-entrypoint.d/ gera /etc/nginx/conf.d/default.conf
# NGINX_API_HOST=api (Compose) | tasks.api (Swarm — DNS das tasks, evita VIP com refused)
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_API_HOST=api

# Copy built frontend
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
