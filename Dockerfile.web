# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files from root (frontend)
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code (everything except server)
COPY . ./

# Remove server folder (we don't need it for frontend build)
RUN rm -rf server

# Build the frontend
RUN npm run build

# Debug: list builder dist output (hypothesis A/D)
RUN echo "[TSM-WEB-BUILD] Builder dist contents:" && ls -la /app/dist/ && echo "[TSM-WEB-BUILD] Builder dist/assets:" && ls -la /app/dist/assets/ 2>&1 || true

# Production stage - serve with nginx
FROM nginx:alpine AS production

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend (hypothesis B)
COPY --from=builder /app/dist /usr/share/nginx/html

# Debug entrypoint: list files at runtime (hypothesis B/C/E)
COPY docker-web-entrypoint.sh /docker-web-entrypoint.sh
RUN sed -i 's/\r$//' /docker-web-entrypoint.sh
RUN chmod +x /docker-web-entrypoint.sh

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

ENTRYPOINT ["/docker-web-entrypoint.sh"]
