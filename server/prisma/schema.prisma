// TSM EX v2.0 - Complete Prisma Schema
// Logistics Orchestrator with AI-powered consolidation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// AUTH & USERS
// ========================================

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  password String
  roles    UserRole[] @default([]) // Múltiplos papéis por email (Link, Hub, Admin, Cliente)
  active   Boolean    @default(true)

  // Account relationship (for CLIENT users)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Person (CPF/CNPJ - identificador único; usado para usuários de contas e HUB)
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  // Hub (quando role = HUB; usuário opera este depósito)
  hubId String?
  hub   Hub?    @relation(fields: [hubId], references: [id], onDelete: SetNull)

  client              Client?
  link                Link?
  admin               Admin?
  hubOnboarding       HubOnboarding?
  uploadedAttachments Attachment[]

  // Permissões por pessoa (Admin define para cada usuário HUB)
  permissions String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AttachmentType {
  IMAGE
  DOCUMENT
  OTHER
}

model Attachment {
  id               String         @id @default(uuid())
  type             AttachmentType @default(OTHER)
  fileName         String
  mimeType         String
  size             Int
  storageKey       String         @unique
  bucket           String
  url              String?
  checksum         String?
  metadata         Json?
  uploadedByUserId String?
  uploadedByUser   User?          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  orderLinks  OrderAttachment[]
  demandLinks DemandAttachment[]

  createdAt DateTime @default(now())

  @@index([uploadedByUserId])
  @@index([createdAt])
}

model OrderAttachment {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  category     String?
  createdAt    DateTime   @default(now())

  @@unique([orderId, attachmentId])
  @@index([orderId, createdAt])
}

model DemandAttachment {
  id           String     @id @default(uuid())
  demandId     String
  demand       Demand     @relation(fields: [demandId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  category     String?
  createdAt    DateTime   @default(now())

  @@unique([demandId, attachmentId])
  @@index([demandId, createdAt])
}

enum UserRole {
  ADMIN
  CLIENT
  LINK
  HUB
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  consolidationFeedbacks ConsolidationFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// PERSON (Pessoa - identificador único CPF/CNPJ)
// ========================================

enum PersonDocumentType {
  CPF
  CNPJ
}

model Person {
  id           String             @id @default(uuid())
  documentType PersonDocumentType
  document     String             @unique // só números, normalizado; único global
  legalName    String // razão social ou nome completo
  tradeName    String? // fantasia (opcional)

  // Endereço
  cep          String?
  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  cityIbgeCode String?
  country      String? @default("BRASIL")

  // PJ
  stateRegistration     String?
  municipalRegistration String?

  // Relações (papéis)
  clients        Client[]
  links          Link[]
  users          User[]
  hubs           Hub[]
  fiscalEmitters FiscalEmitter[]
  drivers        Driver[]

  // Orders (partes)
  ordersAsRemetente     Order[] @relation("OrderRemetente")
  ordersAsDestinatario  Order[] @relation("OrderDestinatario")
  ordersAsConsignatario Order[] @relation("OrderConsignatario")
  ordersAsExpedidor     Order[] @relation("OrderExpedidor")
  ordersAsRedespachante Order[] @relation("OrderRedespachante")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// CLIENT
// ========================================

model Client {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Person (Pessoa - CNPJ/CPF único)
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  // Account relationship
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // AccountCompany relationship (which CNPJ this Client represents)
  accountCompanyId String?
  accountCompany   AccountCompany? @relation(fields: [accountCompanyId], references: [id], onDelete: SetNull)

  companyName String
  tradeName   String?
  document    String  @unique // CNPJ (espelha Person.document para compatibilidade)

  // Contact
  contactName String
  phone       String

  // Default origin
  defaultOrigin String?

  demands       Demand[]
  pricingTables PricingTable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// VEHICLE TYPES
// ========================================

model VehicleType {
  id   String @id @default(uuid())
  name String // "Carreta Baú", "Truck", "Van", "Passeio"
  code String @unique

  // Maximum capacities
  maxWeight Float // kg
  maxVolume Float // m³
  maxValue  Float // R$ max cargo value (insurance)

  // Dimensions (optional)
  length Float? // meters
  width  Float? // meters
  height Float? // meters

  // Characteristics
  enclosed     Boolean @default(true) // Closed box?
  refrigerated Boolean @default(false) // Refrigerated?

  active    Boolean    @default(true)
  links     Link[]
  manifests Manifest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// HUBs
// ========================================

model Hub {
  id   String @id @default(uuid())
  name String // "HUB Imperatriz"
  code String @unique // "IMP-MA"

  // Pessoa jurídica dona do depósito/filial (opcional)
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  // Location
  city         String
  state        String
  cityIbgeCode String?
  address      String?
  lat          Float?
  lng          Float?

  // Coverage
  coverageCities String[] // Cities served
  coverageRadius Float? // km

  // Capacities
  storageCapacity Float? // m³
  dailyThroughput Float? // volumes/day

  // Contact
  managerName String?
  phone       String?
  email       String?

  // Fiscal / emissao CT-e e Minuta
  rntrc            String? // RNTRC (registro ANTT) - obrigatorio para CT-e
  lastCteNumber    Int      @default(0) // Ultimo numero CT-e emitido
  lastDceNumber    Int      @default(0) // Ultimo numero DC-e emitido
  lastMinutaNumber Int      @default(0) // Ultimo numero Minuta emitido
  simplesNacional  Boolean? // Regime fiscal (impacta ICMS)

  roles HubRole[]

  // Relationships
  manifests            Manifest[]
  manifestsDestination Manifest[]                @relation("ManifestDestHub")
  manifestStopsAsDest  ManifestStop[]            @relation("ManifestStopDestHub")
  ordersAtHub          Order[] // Orders com status AT_HUB neste hub (currentHubId)
  expectedDemands      Demand[]                  @relation("DemandExpectedHub")
  users                User[] // Usuários que operam este hub (role HUB)
  freightCalculations  OrderFreightCalculation[]
  fiscalEmitters       FiscalEmitter[]
  commissionAgreements HubCommissionAgreement[]

  // Management
  canOrchestrate Boolean @default(false) // Can act as orchestrator
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Onboarding do Hub (dados do depósito, responsável, documentos, bancários; simétrico ao Link)
model HubOnboarding {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  depositData Json? // { name, code, city, state, address }
  contactData Json? // { managerName, phone, email }
  documents   Json? // { cnpjUrl?, proofOfAddressUrl? }
  bankData    Json? // { bank, agency, account, holderName, pixKey, pixKeyType }

  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ========================================
// LINKS (Transportadores)
// ========================================

model Link {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Person (Pessoa - CPF/CNPJ único)
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  // Registration data
  name     String
  document String  @unique // CPF or CNPJ (espelha Person.document para compatibilidade)
  phone    String
  email    String?

  // Vehicle (vehicleTypeId set by admin on approval when null)
  vehicleTypeId String?
  vehicleType   VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  vehiclePlate  String
  vehicleYear   Int?
  trailerPlate  String? // Carreta/reboque 1 (composição veicular, CIOT)
  trailer2Plate String? // Carreta/reboque 2 (bitrem/rodotrem, composição veicular)
  trailer3Plate String? // Carreta/reboque 3 (rodotrem; até 4 placas com o cavalo)
  vehicleAxles  Int? // Número de eixos — crítico para cálculo de piso mínimo ANTT

  // Documents
  cnhNumber String?
  cnhExpiry DateTime?
  crlvUrl   String?
  photoUrl  String?

  // CIOT / ANTT (transportador contratado)
  rntrc                String? // Registro ANTT do transportador
  carrierType          LinkCarrierType?
  vehicleOwnerDocument String? // CPF/CNPJ do proprietário do veículo, se diferente do próprio Link
  vehicleOwnerName     String?
  vehicleChassi        String? // Obrigatório no Gravar Veículo da eFrete
  vehicleRenavam       String?
  vehicleBodyType      String? // TipoCarroceria eFrete: Aberta | FechadaOuBau | Granelera | PortaContainer | Sider | NaoAplicavel
  vehicleWheelType     String? // TipoRodado eFrete: Truck | Toco | Cavalo | NaoAplicavel

  // Coverage areas
  homeBase       String // Base city
  coverageStates String[] // States covered

  // Performance
  score         Float @default(5.0)
  deliveryCount Int   @default(0)
  onTimeRate    Float @default(1.0)

  // Status
  approvalStatus LinkApprovalStatus @default(PENDING)
  active         Boolean            @default(false)

  // WhatsApp (Evolution API)
  whatsappPhone String?
  whatsappOptIn Boolean @default(false)

  manifests         Manifest[]
  onboarding        LinkOnboarding?
  pricingAgreements LinkPricingAgreement[]
  drivers           Driver[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LinkCarrierType {
  TAC // Transportador Autônomo de Carga
  ETC // Empresa de Transporte de Cargas
  CTC // Cooperativa de Transporte de Cargas
  FROTA // Frota própria contratada
}

// Motorista — papel vinculado a um Link (transportador contratado). Um TAC autônomo
// tem exatamente 1 Driver (espelhando os próprios dados); ETC/CTC podem ter N.
model Driver {
  id     String @id @default(uuid())
  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // Endereço do motorista (obrigatório no Gravar Motorista da eFrete) — reaproveita Person
  // em vez de duplicar campos; TAC autônomo aponta pro mesmo Person do próprio Link.
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  name      String
  document  String    @unique // CPF
  phone     String
  birthDate DateTime? // Obrigatório no Gravar Motorista da eFrete
  cnhNumber String?
  cnhExpiry DateTime?

  active Boolean @default(true)

  manifests Manifest[] @relation("ManifestDriver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([linkId])
}

// Onboarding data for Link (documents, contacts, vehicle photos, bank, video)
model LinkOnboarding {
  id     String @id @default(uuid())
  linkId String @unique
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // Personal documents (JSON: { cnhNumber?, cnhExpiry?, cnhPhotoUrl?, cnhWithFaceUrl?, rgNumber?, rgOrg?, rgPhotoUrl?, proofOfAddressUrl? })
  documentsPersonal Json?

  // Cavalo docs (JSON: { vehicleDocUrl?, ownerDocUrl?, anttUrl?, extracted? })
  documentsCavalo Json?

  // Carreta docs, only if hasTrailer (JSON: { vehicleDocUrl?, ownerDocUrl?, companyData?, anttUrl?, extracted? })
  documentsCarreta Json?

  // Contacts: personal (3), professional (3+)
  contactsPersonal     Json? // [{ name, phone, relation }]
  contactsProfessional Json? // [{ name, phone, companyOrRole }]

  // Vehicle photos (JSON: [{ url, label? }])
  vehiclePhotos Json?

  // Bank (JSON: { bank, agency, account, accountType, holderName, holderDocument })
  bankData Json?

  // Video URL after approval (prestação de serviço)
  videoConfirmationUrl String?

  // Provisional: has trailer (UI only; admin assigns VehicleType on approval)
  hasTrailer Boolean @default(false)

  // Set when user has submitted all required steps (access to app only after this)
  onboardingComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LinkApprovalStatus {
  PENDING // Awaiting approval
  APPROVED // Approved
  REJECTED // Rejected
  SUSPENDED // Temporarily suspended
}

// ========================================
// PRICING
// ========================================

model PricingRoute {
  id         String @id @default(uuid())
  name       String // "CD SP-GRU > CD SM-MARANHÃO"
  originCode String
  originName String
  destCode   String
  destName   String

  tables PricingTable[]
  orders Order[]
  active Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingTable {
  id String @id @default(uuid())

  // Identification
  description String // "GELADEIRA ** 15% + ICMS"
  code        String? // Internal code

  // Application scope
  type     PricingTableType // SPECIAL (client) or GENERAL
  clientId String?
  client   Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Account relationship (for shared pricing tables across CNPJs)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Route (optional - can be "None")
  routeId String?
  route   PricingRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  // Freight configuration
  freightValue Float? // Numeric value
  freightUnit  FreightUnit // RS_KG, PERCENT, RS_M3, RS_UNIT

  // Minimum freight
  minFreightValue Float?
  minFreightUnit  MinFreightUnit? // RS or KG

  // Additional fees
  adValoremPercent Float? // % on NF value (per R$ 1000)
  grisPercent      Float? // GRIS % (per R$ 1000)
  tollValue        Float? // Toll
  tollUnit         TollUnit? // RS_KG or FIXED
  dispatchFee      Float? // Dispatch R$
  otherFees        Float? // Others R$

  // Cubing
  cubeEnabled Boolean @default(false)
  cubeFactor  Float? // Ex: 300 kg/m³

  // ICMS
  icmsIncluded Boolean @default(false)
  icmsPercent  Float? // If not included, how much to add

  // Ad Valorem Threshold
  adValoremThreshold Float? // "If value > X, charge advalorem separately"

  // Minimum freight ranges
  minFreightRanges MinFreightRange[]

  freightCalculations OrderFreightCalculation[]

  // Status
  active   Boolean @default(true)
  priority Int     @default(0) // Higher = priority

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PricingTableType {
  SPECIAL // Special table for client
  GENERAL // General table
}

enum FreightUnit {
  RS_KG // R$/Kg
  PERCENT // %
  RS_M3 // R$/m³
  RS_UNIT // R$/Unit
}

enum MinFreightUnit {
  RS // Value in reais
  KG // Minimum weight in kg
}

enum TollUnit {
  RS_KG // R$/Kg
  FIXED // Fixed value
}

model MinFreightRange {
  id             String       @id @default(uuid())
  pricingTableId String
  pricingTable   PricingTable @relation(fields: [pricingTableId], references: [id], onDelete: Cascade)

  minWeight Float // Minimum weight of range (Kgs)
  maxWeight Float? // Maximum weight (null = no limit)
  value     Float // Minimum freight value (R$)

  createdAt DateTime @default(now())
}

// ========================================
// DEMANDS
// ========================================

model Demand {
  id          String @id @default(uuid())
  orderNumber Int    @unique // numero sequencial de pedido, continua a numeracao do sistema legado
  clientId    String
  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // NF Info
  nfNumber String
  nfValue  Float

  // Origin/Destination
  origin      String
  destination String

  // Cargo
  commodity   String
  weight      Float // real kg
  volume      Float // m³
  cubedWeight Float? // cubed weight
  units       Int    @default(1)

  // Classification
  riskClass RiskClass

  // Intent
  intentType DemandIntent // QUOTE_ONLY, COLLECT, DROP_AT_HUB

  // Quote
  status        DemandStatus @default(PENDING)
  quotedPrice   Float?
  quotedAt      DateTime?
  quotedTableId String?

  // Events
  events      DemandEvent[]
  attachments DemandAttachment[]

  // Metadata
  sourceType DemandSource // CHAT, FORM, BATCH, API, intake sources, etc.

  // Intake / pré-entrada universal (PR002+)
  documentType       DemandDocumentType?
  documentKey        String?
  externalReference  String?
  expectedHubId      String?
  expectedHub        Hub?                @relation("DemandExpectedHub", fields: [expectedHubId], references: [id], onDelete: SetNull)
  intakeCompleteness CompletenessLevel   @default(INCOMPLETE)
  missingFields      String[]            @default([])
  declarationData    Json?
  rawInputData       Json?

  // Order relationship
  order Order?

  // Invoices
  invoices Invoice[]

  // Origem em documento descoberto via Distribuição NF-e (triagem, sourceType DFE_ACBR)
  nfeDistribuicaoOrigin NfeDistribuicaoDocumento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, externalReference])
  @@index([expectedHubId])
  @@index([status, expectedHubId])
}

enum DemandIntent {
  QUOTE_ONLY // Only wants quote
  COLLECT // Wants pickup
  DROP_AT_HUB // Will drop at HUB
}

enum DemandSource {
  CHAT // Via AI chat
  FORM // Via form
  BATCH // Batch upload
  API // B2B integration
  DFE_ACBR // Distribuição NF-e ACBr (PR003)
  NFE_KEY // Chave NF escaneada/digitada
  MANUAL_HUB // Entrada manual no Hub
  DECLARATION // Declaração de conteúdo
}

enum DemandDocumentType {
  NFE
  DECLARATION
  CTE
  MANUAL_REFERENCE
  NO_DOCUMENT_YET
}

enum DemandStatus {
  AWAITING_ARRIVAL // Pré-entrada: aguardando chegada física no Hub
  PENDING // Awaiting quote
  QUOTED // Quoted
  APPROVED // Client approved
  CONVERTED // Virou pedido (fronteira da posse)
  LOST
  CANCELLED // Cancelled
}

enum RiskClass {
  A // High risk (electronics, high value)
  B // Medium risk
  C // Low risk
}

model DemandEvent {
  id       String @id @default(uuid())
  demandId String
  demand   Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  status      DemandStatus
  description String
  location    String?
  photoUrl    String?

  createdAt DateTime @default(now())
}

// ========================================
// MANIFESTS
// ========================================

enum ManifestTripType {
  TRANSFER
  DELIVERY
  TRANSFER_DELIVERY
  REGIONAL_DISTRIBUTION // reservado — sem comportamento operacional no PR001
}

model Manifest {
  id String @id @default(uuid())

  // Trip classification
  tripType  ManifestTripType @default(TRANSFER)
  destHubId String?
  destHub   Hub?             @relation("ManifestDestHub", fields: [destHubId], references: [id], onDelete: SetNull)

  // Assignment
  linkId String?
  link   Link?   @relation(fields: [linkId], references: [id], onDelete: SetNull)
  hubId  String?
  hub    Hub?    @relation(fields: [hubId], references: [id], onDelete: SetNull)

  // Motorista da viagem (passo "Definir Motorista", separado do Link/transportador contratado)
  driverId String?
  driver   Driver? @relation("ManifestDriver", fields: [driverId], references: [id], onDelete: SetNull)

  // CIOT
  ciotTipoViagemOverride CiotTipoViagem?
  ciotDispensado         Boolean         @default(false)
  ciotDispensadoMotivo   String?

  // Capa da viagem (Fatia C)
  fiscalEmitterId    String?
  fiscalEmitter      FiscalEmitter?            @relation("ManifestFiscalEmitter", fields: [fiscalEmitterId], references: [id], onDelete: SetNull)
  plannedDepartureAt DateTime?
  plannedArrivalAt   DateTime?
  notes              String?                   @db.Text
  seloLacre          String? // lacre(s) da carroceria, separados por vírgula quando houver mais de um
  liberacao          String?
  kmSaida            Float? // gravado no início real da viagem (startManifest)
  kmChegada          Float? // gravado na conclusão da última parada
  freightAgreement   ManifestFreightAgreement?

  // Vehicle type
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  // Route
  origin                      String
  originCity                  String?
  originState                 String?
  originCityIbgeCode          String?
  destination                 String
  destinationCity             String?
  destinationState            String?
  destinationCityIbgeCode     String?
  startsWithCollection        Boolean @default(false)
  stops                       Json? // legado — nunca consumido pela lógica de pernas; ver ManifestStop (Fatia B)

  // Pontos manuais opcionais de percurso. OrderLeg só se vincula quando a parada
  // representa uma descarga operacional, nunca por inferência automática.
  tripStops ManifestStop[]

  // Occupancy
  totalWeight Float @default(0)
  totalVolume Float @default(0)
  totalValue  Float @default(0)

  // Status
  status ManifestStatus @default(DRAFT)

  // Assigned legs
  legs OrderLeg[]

  // Orders
  orders Order[]

  // Invoices
  invoices Invoice[]

  // Acceptance
  offeredAt       DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  // Execution
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Fiscal travel documents (MDF-e, CIOT and future trip-level docs)
  fiscalDocuments  ManifestFiscalDocument[]
  ciotEmissionJobs CiotEmissionJob[]
}

enum CiotTipoViagem {
  PADRAO // Lotação — 1 contratante, valida piso mínimo, não permite retificação
  FRACIONADO // Composição de carga multi-cliente (modelo Teia)
  TAC_AGREGADO // Múltiplas viagens com o mesmo TAC em até 30 dias
}

enum ManifestStatus {
  DRAFT // Draft
  PENDING_ACCEPT // Offered to LINK
  ACCEPTED // LINK accepted
  IN_PROGRESS // In execution
  COMPLETED // Completed
  CANCELLED // Cancelled
}

enum ManifestFiscalDocType {
  MDFE
  CIOT
}

enum ManifestFiscalDocStatus {
  DRAFT
  READY
  SENT
  REJECTED
  AUTHORIZED
  CLOSED
  CANCELLED
}

enum FiscalEnvironment {
  HOMOLOGACAO
  PRODUCAO
}

enum FiscalProvider {
  SIMULATED
  ACBR
  NUVEM_FISCAL
  FOCUS_NFE
  TECNOSPEED
  PLUGNOTAS
  OTHER
}

enum FiscalProviderStatus {
  NOT_CONFIGURED
  PENDING
  READY
  ERROR
}

enum FiscalCertificateStatus {
  MISSING
  READY
  EXPIRED
  INVALID
}

enum FiscalTaxRegime {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  OUTRO
}

model FiscalEmitter {
  id String @id @default(uuid())

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  hubId String?
  hub   Hub?    @relation(fields: [hubId], references: [id], onDelete: SetNull)

  displayName    String?
  tradeName      String?
  logoUrl        String?
  logoStorageKey String?
  footerNote     String? @db.Text

  rntrc            String?
  taxRegime        FiscalTaxRegime?
  crt              String?
  cteSeries        Int               @default(1)
  lastCteNumber    Int               @default(0)
  lastDceNumber    Int               @default(0)
  lastMinutaNumber Int               @default(0)
  /// CFOP padrão do CT-e (e DC-e quando não informado no cálculo)
  defaultCteCfop   String?
  /// CST do ICMS padrão do CT-e (e DC-e quando não informado no cálculo)
  defaultCteCst    String?
  environment      FiscalEnvironment @default(HOMOLOGACAO)

  provider          FiscalProvider       @default(SIMULATED)
  providerEmitterId String?
  providerStatus    FiscalProviderStatus @default(NOT_CONFIGURED)

  certificateStorageKey        String?
  certificateFileName          String?
  certificatePasswordEncrypted String?                 @db.Text
  certificateExpiresAt         DateTime?
  certificateFingerprint       String?
  certificateStatus            FiscalCertificateStatus @default(MISSING)

  active                 Boolean @default(true)
  defaultForHub          Boolean @default(false)
  /// Opt-in explícito: liga a varredura automática 2x/dia da Distribuição NF-e para este CNPJ como destinatário.
  /// Nunca ligar sem antes semear FiscalDistribuicaoCheckpoint.ultimoNsu (ver bootstrap-nsu) — o coordenador
  /// e o processor recusam-se a rodar dist-nsu a partir de NSU=0 (custo retroativo de ~90 dias em créditos).
  distribuicaoNfeEnabled Boolean @default(false)

  freightCalculations       OrderFreightCalculation[]
  manifestFiscalDocuments   ManifestFiscalDocument[]
  nfeDistribuicaoDocumentos NfeDistribuicaoDocumento[]
  manifestsAsTripEmitter    Manifest[]                 @relation("ManifestFiscalEmitter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId])
  @@index([hubId])
  @@index([active])
}

model ManifestFiscalDocument {
  id         String   @id @default(uuid())
  manifestId String
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  fiscalEmitterId String?
  fiscalEmitter   FiscalEmitter? @relation(fields: [fiscalEmitterId], references: [id], onDelete: SetNull)

  documentType ManifestFiscalDocType
  status       ManifestFiscalDocStatus @default(DRAFT)

  number       String?
  series       Int?
  environment  String?
  accessKey    String?
  protocol     String?
  statusReason String? @db.Text
  xmlUrl       String?
  pdfUrl       String?
  rawPayload   Json?
  rawResponse  Json?

  authorizedAt DateTime?
  rejectedAt   DateTime?
  closedAt     DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([manifestId])
  @@index([fiscalEmitterId])
  @@index([documentType, status])
}

// ========================================
// FEEDBACK/LEARNING
// ========================================

model ConsolidationFeedback {
  id          String    @id @default(uuid())
  adminId     String?
  admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorRole   UserRole?

  action FeedbackAction

  // Context
  orderIds           String[]
  suggestedManifests Json
  finalManifests     Json?

  // Metrics for learning
  utilizationBefore Float?
  utilizationAfter  Float?
  marginBefore      Float?
  marginAfter       Float?

  createdAt DateTime @default(now())
}

enum FeedbackAction {
  ACCEPTED
  MODIFIED
  REJECTED
}

// ========================================
// LLM CONFIGURATION
// ========================================

model LLMProvider {
  id   String @id @default(uuid())
  name String // "OpenAI", "Google Gemini", "DeepSeek"
  code String @unique // "openai", "gemini", "deepseek"

  // API Configuration
  apiFormat String @default("openai") // "openai" | "gemini" | "anthropic"
  baseUrl   String // https://api.openai.com/v1, https://api.deepseek.com, etc

  // Features
  supportsTools Boolean @default(true) // Function calling support

  // Management
  isBuiltIn Boolean @default(false) // Pre-configured vs custom
  active    Boolean @default(true)

  models LLMModel[]
  apiKey LLMApiKey?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LLMModel {
  id String @id @default(uuid())

  // Provider relationship
  providerId String
  provider   LLMProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Model info
  name        String // "GPT-4o", "Gemini Pro", "Claude 3.5 Sonnet"
  modelId     String // "gpt-4o", "gemini-pro", "claude-3-5-sonnet"
  description String?

  // Capabilities
  capabilities  String[] // ["chat", "vision", "function_calling", "json_mode"]
  contextWindow Int      @default(8192) // tokens
  maxOutput     Int      @default(4096)

  // Pricing (per 1M tokens)
  inputPrice  Float? // USD
  outputPrice Float? // USD

  // Status
  isDefault Boolean @default(false) // Default for its capability
  active    Boolean @default(true)

  // Usage tracking
  totalTokens Int       @default(0)
  totalCalls  Int       @default(0)
  lastUsedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Chat configuration relations
  chatFixedConfig    ChatLLMConfig[]   @relation("ChatFixedModel")
  chatRotationConfig ChatLLMRotation[] @relation("ChatRotationModel")

  @@unique([providerId, modelId])
}

// ========================================
// CHAT LLM CONFIGURATION
// ========================================

model ChatLLMConfig {
  id String @id @default(uuid())

  // Model selection mode
  selectionMode String @default("FIXED") // "FIXED" | "ROTATION" | "LOAD_BALANCE"

  // Fixed model (if mode is FIXED)
  fixedModelId String?
  fixedModel   LLMModel? @relation("ChatFixedModel", fields: [fixedModelId], references: [id], onDelete: SetNull)

  // Rotation models (if mode is ROTATION)
  rotationModels ChatLLMRotation[]

  // Settings
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatLLMRotation {
  id       String        @id @default(uuid())
  configId String
  config   ChatLLMConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  modelId String
  model   LLMModel @relation("ChatRotationModel", fields: [modelId], references: [id], onDelete: Cascade)

  weight Int     @default(1) // 1-10, usado para distribuição
  active Boolean @default(true)

  order Int @default(0) // Ordem na rotação

  createdAt DateTime @default(now())

  @@unique([configId, modelId])
  @@index([configId])
}

// Identidade visual global (impressos: minuta, CT-e, MDF-e, etc.)
model VisualIdentity {
  id String @id // aplicação usa sempre "default"

  legalName   String? // razão social
  tradeName   String? // nome fantasia
  cnpjDisplay String?
  phone       String?
  email       String?
  addressLine String?
  footerNote  String?

  logoUrl        String?
  logoStorageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LLMApiKey {
  id         String      @id @default(uuid())
  providerId String      @unique
  provider   LLMProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // API key (stored as-is for simplicity, encrypt in production)
  apiKey     String
  keyPreview String // Last 4 chars: "...xyz1"

  // Metadata
  label  String? // "Production Key", "Dev Key"
  active Boolean @default(true)

  // Usage limits
  monthlyLimit Float? // USD
  monthlyUsage Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// CRM & COMMERCIAL PIPELINE
// ========================================

model Account {
  id String @id @default(uuid())

  // Identification
  name        String // "Empresa ABC Ltda"
  accountType AccountType @default(COMPANY)

  // Empresas/CNPJs (may have multiple)
  companies AccountCompany[]

  // Contacts (individuals in the account)
  contacts AccountContact[]

  // Users belonging to this account
  users User[]

  // Clients associated with this account
  clients Client[]

  // Pricing tables shared across all CNPJs in this account
  pricingTables PricingTable[]

  // Relations
  opportunities Opportunity[]
  chatSessions  ChatSession[]
  invoices      Invoice[]

  // Meta
  tags       String[] @default([])
  assignedTo String? // Admin ID responsible

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccountType {
  COMPANY // Company (can have multiple CNPJs)
  INDIVIDUAL // Individual person
}

model AccountCompany {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  cnpj      String  @unique
  legalName String // Legal name
  tradeName String?

  // Default address
  address      String?
  city         String?
  state        String?
  cityIbgeCode String?

  isPrimary Boolean @default(false)

  // Clients associated with this company
  clients Client[]

  createdAt DateTime @default(now())

  @@index([accountId])
}

model AccountContact {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name     String
  role     String? // "Logistics Manager"
  email    String?
  phone    String?
  whatsapp String?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([accountId])
}

model Opportunity {
  id String @id @default(uuid())

  // CRM
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Conversation
  sessionId String // Chat session ID
  source    OpportunitySource @default(CHAT)

  // Status
  stage        OpportunityStage  @default(QUOTE)
  completeness CompletenessLevel @default(INCOMPLETE)

  // Type
  type OpportunityType @default(QUOTE_ONLY)

  // Quote data (may be partial)
  cpfCnpjSender         String?
  cpfCnpjReceiver       String?
  cpfCnpjTransportadora String? // CNPJ da transportadora (redespacho)

  origin      String? // City
  destination String? // City

  commodity  String?
  nfValue    Float?
  weight     Float?
  volumes    Int?
  dimensions String? // JSON or string "100x50x30"

  // Collection
  needsCollection Boolean @default(false)
  collectionData  Json? // {address, contact, time, needsHelper}

  // Calculated quote
  quotedPrice    Float?
  quoteBreakdown Json? // {freight, gris, advalorem, icms, total}
  validUntil     DateTime? // Quote validity

  // Conversation history
  conversationSnapshot Json[] @default([])

  // Follow-up
  lastFollowUp  DateTime?
  nextFollowUp  DateTime? // Scheduled for AI follow-up
  followUpCount Int       @default(0)

  // If becomes physical demand
  matchedDemandId String? // Demand that matched this opportunity

  // Account role: REMETENTE | DESTINATARIO | CONSIGNATARIO (apenas responsável financeiro)
  accountRole OpportunityAccountRole?

  // Freight term
  freightTerm FreightTerm?

  // Orders
  orders Order[]

  // Pipeline column (Kanban)
  pipelineColumnId String?
  pipelineColumn   PipelineColumn? @relation(fields: [pipelineColumnId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, stage])
  @@index([nextFollowUp])
  @@index([sessionId])
  @@index([pipelineColumnId])
}

enum OpportunityAccountRole {
  REMETENTE // CNPJ remetente está na conta
  DESTINATARIO // CNPJ destinatário está na conta
  CONSIGNATARIO // Apenas responsável financeiro; remetente e destinatário são terceiros
}

enum OpportunityStage {
  QUOTE // Just quoted
  FOLLOW_UP // In follow-up
  COLLECTION_REQUESTED // Requested collection
  CONVERTED // Became real demand
  LOST // Lost (no response, gave up)
}

enum CompletenessLevel {
  MINIMAL // Only origin/destination
  INCOMPLETE // Missing critical data (weight, NF value)
  COMPLETE // All data
}

enum OpportunityType {
  QUOTE_ONLY
  TRANSPORT
  COLLECTION
  BOTH
}

enum OpportunitySource {
  CHAT // Web chat
  WHATSAPP // WhatsApp (future)
  PHONE // Phone call
  EMAIL // Email
  MANUAL // Manually created by admin
  FORM // Via form (cotação / coleta)
  ENTRADA // Entrada manual - cadastro pendente comercial
}

enum FreightTerm {
  CIF // Cost, Insurance and Freight - remetente paga
  FOB // Free On Board - destinatário paga
  REDESPACHO // Terceira transportadora - consignatário paga
}

model ChatSession {
  id String @id @default(uuid())

  accountId String? // Can start anonymous
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  slug String @unique // URL /chat/abc123

  historyJson Json[] @default([]) // Legacy: Complete history as JSON (deprecated, use messages relation)

  // Progressive identification
  identifiedAt DateTime? // When client was identified
  identifiedBy String? // cpf/cnpj/name

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Messages in this session (structured)
  messages ChatMessage[]

  @@index([slug])
  @@index([accountId])
}

// ========================================
// LOCATIONS (Estados, Cidades, CEPs)
// ========================================

model State {
  id       String @id @default(uuid())
  code     String @unique // "SP", "RJ", etc
  name     String // "São Paulo"
  ibgeCode String @unique // Código IBGE do estado

  cities City[]
  ceps   CEP[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id      String @id @default(uuid())
  stateId String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  name     String
  ibgeCode String  @unique
  cepStart String? // CEP inicial (opcional)
  cepEnd   String? // CEP final (opcional)

  ceps CEP[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stateId])
  @@index([name])
}

model CEP {
  id  String @id @default(uuid())
  cep String @unique // "01310100" (sem hífen)

  logradouro String?
  bairro     String?
  cityId     String?
  city       City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  stateId    String?
  state      State?  @relation(fields: [stateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cep])
  @@index([cityId])
}

// ========================================
// CHAT MESSAGES & ATTACHMENTS
// ========================================

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    String // "user" | "assistant" | "system"
  content String

  // File attachments
  attachments ChatAttachment[]

  createdAt DateTime @default(now())

  @@index([sessionId])
}

model ChatAttachment {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  type     String // "IMAGE" | "AUDIO" | "DOCUMENT" | "NF"
  fileName String
  fileUrl  String // URL do arquivo armazenado
  mimeType String
  size     Int // bytes

  // Para NF
  extractedData Json? // Dados extraídos da NF (OCR/parsing)

  createdAt DateTime @default(now())

  @@index([messageId])
}

// ========================================
// ORDERS (PEDIDOS)
// ========================================

model Order {
  id String @id @default(uuid())

  // Relacionamentos
  demandId String @unique
  demand   Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  manifestId String?
  manifest   Manifest? @relation(fields: [manifestId], references: [id], onDelete: SetNull)

  // Hub onde o pedido está quando status = AT_HUB
  currentHubId String?
  currentHub   Hub?    @relation(fields: [currentHubId], references: [id], onDelete: SetNull)

  // Status do pedido
  status OrderStatus @default(PENDING)

  // Informações de NF/Declaração
  nfNumber      String? // Número da NF (pode vir da Demand ou ser atualizado)
  nfDocumentUrl String? // URL do documento NF/Declaração

  // Pessoas (entrada manual)
  freightTerm           FreightTerm?
  remetentePersonId     String?
  remetentePerson       Person?       @relation("OrderRemetente", fields: [remetentePersonId], references: [id], onDelete: SetNull)
  destinatarioPersonId  String?
  destinatarioPerson    Person?       @relation("OrderDestinatario", fields: [destinatarioPersonId], references: [id], onDelete: SetNull)
  consignatarioPersonId String?
  consignatarioPerson   Person?       @relation("OrderConsignatario", fields: [consignatarioPersonId], references: [id], onDelete: SetNull)
  expedidorPersonId     String?
  expedidorPerson       Person?       @relation("OrderExpedidor", fields: [expedidorPersonId], references: [id], onDelete: SetNull)
  redespachantePersonId String?
  redespachantePerson   Person?       @relation("OrderRedespachante", fields: [redespachantePersonId], references: [id], onDelete: SetNull)
  origemPrestacao       String?
  origemIbgeCode        String?
  fimPrestacao          String?
  fimIbgeCode           String?
  routeId               String?
  route                 PricingRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  collectionData        Json? // { address, contact, scheduledAt, needsHelper }

  // Quando virou pedido
  createdAt      DateTime  @default(now()) // Quando foi criado (coletado/entrou no CD)
  enteredAtHubAt DateTime? // Quando entrou no HUB/CD

  // Pernas de transporte (multi-perna)
  legs OrderLeg[]

  // Histórico completo (todos os eventos desde Opportunity até entrega)
  history     OrderHistory[]
  attachments OrderAttachment[]

  // Faturamento
  invoices Invoice[]

  // Notas fiscais do pedido (múltiplas NFs por pedido)
  invoicesRel OrderInvoice[]

  // Cálculos de frete (CT-e / Minuta)
  freightCalculations OrderFreightCalculation[]

  updatedAt DateTime @updatedAt

  @@index([demandId])
  @@index([opportunityId])
  @@index([manifestId])
  @@index([status])
  @@index([currentHubId])
}

enum OrderStatus {
  PENDING // Criado, aguardando processamento
  IN_TRANSIT // Em trânsito
  AT_HUB // No HUB/CD
  OUT_FOR_DELIVERY // Saiu para entrega
  DELIVERED // Entregue
  CANCELLED // Cancelado
}

model OrderHistory {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Tipo de evento
  eventType OrderEventType

  // Descrição
  description String
  location    String?
  photoUrl    String?

  // Relacionamento com DemandEvent (se aplicável)
  demandEventId String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

enum OrderEventType {
  CREATED // Pedido criado
  COLLECTED // Coletado
  IN_TRANSIT // Em trânsito
  AT_HUB // Chegou no HUB
  OUT_FOR_DELIVERY // Saiu para entrega
  DELIVERED // Entregue
  CANCELLED // Cancelado
  NOTE // Nota/anotação
}

// ========================================
// ORDER INVOICES (NFs do pedido)
// ========================================

enum OrderInvoiceType {
  NFE
  OUTRAS
}

model OrderInvoice {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type         OrderInvoiceType
  nfNumber     String
  nfKey        String? // Chave NF-e (44 dígitos)
  emissionDate DateTime?
  nature       String? // Ex: VETERINARIO
  species      String? // Ex: Volumes
  volumes      Float            @default(0)
  weight       Float            @default(0)
  cubedVolume  Float?
  value        Float            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// ========================================
// ORDER FREIGHT CALCULATIONS (CT-e / Minuta)
// ========================================

enum FreightDocType {
  CTE // Conhecimento de Transporte Eletrônico (fiscal)
  DCE // Declaração de Conteúdo Eletrônica (fiscal)
  MINUTA // Documento interno (sem validação fiscal)
}

enum FreightCalcMethod {
  ESPECIAL // Tabelas pré-cadastradas do pagador
  TARIFA_GERAL // Tarifas por rota
  INFORMADO // Calculadora manual
}

enum FreightCalcStatus {
  DRAFT // Rascunho
  CALCULATED // Calculado
  CTE_READY // CT-e validado e pronto para envio fiscal
  CTE_SENT // CT-e enviado ao provedor fiscal / SEFAZ
  CTE_PROCESSING // Worker confirmou POST /cte e está fazendo polling assíncrono
  CTE_REJECTED // CT-e rejeitado com pendências recuperáveis
  CTE_PENDING_RECONCILIATION // Timeout de polling OU fila pausada por crédito — precisa de ação manual, NUNCA é rejeição automática
  MINUTA_EMITTED // Minuta emitida
  CTE_AUTHORIZED // CT-e autorizado SEFAZ
  CTE_CANCELLED // CT-e cancelado
  DCE_READY // DC-e pronto para envio
  DCE_SENT
  DCE_REJECTED
  DCE_AUTHORIZED
  DCE_CANCELLED
}

model OrderFreightCalculation {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  documentType    FreightDocType
  emissorId       String
  emissor         Hub            @relation(fields: [emissorId], references: [id], onDelete: Restrict)
  fiscalEmitterId String?
  fiscalEmitter   FiscalEmitter? @relation(fields: [fiscalEmitterId], references: [id], onDelete: SetNull)

  calculationMethod FreightCalcMethod
  pricingTableId    String?
  pricingTable      PricingTable?     @relation(fields: [pricingTableId], references: [id], onDelete: SetNull)
  routeId           String?

  originCity  String?
  destCity    String?
  cfop        String?
  tipoFrete   String?
  cst         String?
  observacoes String? @db.Text

  volumes     Float   @default(0)
  weight      Float   @default(0)
  cubedWeight Float?
  cubage      Float?
  nfValue     Float   @default(0)
  commodity   String?

  freightTotal    Float  @default(0)
  breakdown       Json?
  icmsValue       Float?
  effectiveWeight Float?

  minutaNumber     String?
  cteNumber        String?
  cteSeries        Int?
  cteEnvironment   String?
  cteAccessKey     String?
  cteProtocol      String?
  cteStatusReason  String?           @db.Text
  cteXml           String?           @db.Text
  cteXmlUrl        String?
  ctePdfUrl        String?
  cteXmlStorageKey String?
  ctePdfStorageKey String?
  cteAuthorizedAt  DateTime?
  cteRejectedAt    DateTime?
  cteCancelledAt   DateTime?
  status           FreightCalcStatus @default(DRAFT)

  dceNumber       String?
  dceSeries       Int?
  dceEnvironment  String?
  dceAccessKey    String?
  dceProtocol     String?
  dceStatusReason String?   @db.Text
  dceXml          String?   @db.Text
  dcePdfUrl       String?
  dceAuthorizedAt DateTime?
  dceRejectedAt   DateTime?
  dceCancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cteEmissionJobs CteEmissionJob[]

  @@index([orderId])
  @@index([emissorId])
  @@index([fiscalEmitterId])
  @@index([pricingTableId])
}

// Último NSU Distribuição DF-e (ACBr) por CNPJ/CPF + ambiente
model FiscalDistribuicaoCheckpoint {
  id        String   @id @default(uuid())
  cpfCnpj   String // só dígitos
  ambiente  String // homologacao | producao
  ultimoNsu String   @default("0") // NSU como string para suportar inteiros grandes
  updatedAt DateTime @updatedAt

  /// Cooldown de 1 req/hora que a SEFAZ aplica à Distribuição DF-e por CNPJ+ambiente. Gravado em
  /// `solicitarDistribuicaoNfe` (acbrDistribuicaoNfe.ts) — now()+1h em sucesso, ou now()+N minutos
  /// quando a própria SEFAZ recusa informando o tempo de espera. Null = nenhuma chamada recente.
  distNfeNextAllowedAt DateTime?

  @@unique([cpfCnpj, ambiente])
  @@index([cpfCnpj])
}

// ========================================
// NF SPECIES (ESPÉCIES PARA NOTAS FISCAIS)
// ========================================

model NfSpecies {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// INVOICES (FATURAS)
// ========================================

model Invoice {
  id String @id @default(uuid())

  // Número da fatura
  invoiceNumber String @unique // Ex: "FAT-2026-001"

  // Relacionamentos (pode faturar por Order, Demand ou Manifest)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  demandId String?
  demand   Demand? @relation(fields: [demandId], references: [id], onDelete: SetNull)

  manifestId String?
  manifest   Manifest? @relation(fields: [manifestId], references: [id], onDelete: SetNull)

  // Cliente/Account que será faturado
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Valores
  subtotal  Float // Valor do frete
  taxes     Float @default(0) // Impostos
  discounts Float @default(0) // Descontos
  total     Float // Total a pagar

  // Status
  status InvoiceStatus @default(PENDING)

  // Datas
  issuedAt DateTime  @default(now()) // Data de emissão
  dueDate  DateTime? // Data de vencimento
  paidAt   DateTime? // Data de pagamento

  // Observações
  notes String?

  // Arquivos
  pdfUrl String? // URL do PDF da fatura

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([orderId])
  @@index([demandId])
  @@index([manifestId])
  @@index([status])
  @@index([invoiceNumber])
}

enum InvoiceStatus {
  PENDING // Pendente de pagamento
  PAID // Pago
  OVERDUE // Vencido
  CANCELLED // Cancelado
}

// ========================================
// PIPELINE KANBAN
// ========================================

model PipelineColumn {
  id String @id @default(uuid())

  // Identificação
  name  String // "Aguardando Cliente", "Em Negociação", etc.
  color String @default("#3B82F6") // Cor da coluna (hex)

  // Mapeamento para stages (opcional - se baseada em stage)
  stage OpportunityStage? // Se null, é coluna personalizada

  // Ordem
  order Int @default(0) // Ordem de exibição

  // Filtros (opcional)
  filters Json? // { accountId, source, etc. }

  // Status
  active Boolean @default(true)

  // Opportunities nesta coluna
  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([stage])
}

// ========================================
// FATIA 1 — LOGISTICS MULTI-LEG (OrderLeg)
// ========================================

model OrderLeg {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  manifestId    String
  manifest      Manifest      @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  sequence      Int // ordem na jornada (1, 2, 3...)
  legType       LegType // COLETA | TRANSFERENCIA | ENTREGA
  executedBy    ExecutedBy // HUB | LINK
  originHubId   String? // hub de origem da perna (null na coleta na ponta)
  destHubId     String? // hub de destino da perna (null na entrega final)
  // Parada/descarga desta viagem a que a perna pertence (Fatia B). Null = parada única
  // implícita (comportamento anterior à Fatia B, preservado sem migração de dado).
  stopId        String?
  stop          ManifestStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  completedAt   DateTime?
  allocatedCost Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([orderId, manifestId])
  @@index([orderId])
  @@index([manifestId])
  @@index([stopId])
}

// Uma parada/descarga real dentro de uma viagem — permite manifesto TRANSFER visitando N
// hubs ou DELIVERY com N clientes, cada um concluído independentemente (ver
// completeManifestStop em manifestLifecycle.ts).
model ManifestStop {
  id               String     @id @default(uuid())
  manifestId       String
  manifest         Manifest   @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  sequence         Int // ordem da parada na viagem (1, 2, 3...)
  destHubId        String? // TRANSFER: hub de destino desta parada
  destHub          Hub?       @relation("ManifestStopDestHub", fields: [destHubId], references: [id], onDelete: SetNull)
  destinationLabel String? // DELIVERY: rótulo/endereço livre do cliente desta parada
  destCity         String? // necessário para infMunDescarga do MDF-e quando não há destHubId
  destState        String?
  destCityIbgeCode String?
  purpose          ManifestStopPurpose @default(PASSAGE)
  plannedArrivalAt DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  legs             OrderLeg[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([manifestId, sequence])
  @@index([manifestId])
  @@index([destHubId])
}

enum ManifestStopPurpose {
  PASSAGE
  OPERATIONAL
  TRANSFER
  COLLECTION
  DELIVERY
}

enum LegType {
  COLETA
  TRANSFERENCIA
  ENTREGA
}

enum ExecutedBy {
  HUB
  LINK
}

enum HubRole {
  RECEBIMENTO
  COLETA
  DISTRIBUICAO
  TRIAGEM
}

// Carta Frete estruturada (Fatia C) — valor real acordado com o Link/transportador para esta
// viagem específica. Quando existe, é a fonte oficial de custo do Link (substitui a estimativa
// de LinkPricingAgreement em calculateLinkCost/getManifestMargin).
model ManifestFreightAgreement {
  id                       String   @id @default(uuid())
  manifestId               String   @unique
  manifest                 Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  freteBruto               Float
  adiantamento             Float    @default(0)
  pedagio                  Float    @default(0)
  irrf                     Float    @default(0)
  inss                     Float    @default(0)
  issqn                    Float    @default(0)
  sestSenat                Float    @default(0)
  outrosDescontos          Float    @default(0)
  outrosDescontosDescricao String?
  saldoLiquido             Float // sempre recalculado no backend — nunca aceitar input direto
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model LinkPricingAgreement {
  id              String       @id @default(uuid())
  linkId          String
  link            Link         @relation(fields: [linkId], references: [id], onDelete: Cascade)
  originCity      String
  destinationCity String
  vehicleTypeCode String // Code referencing VehicleType
  flatRate        Float
  ratePerM3       Float? // Opcional: adicional por metro cúbico
  ratePerKg       Float? // Opcional: adicional por kg
  costMode        LinkCostMode @default(FLAT)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([linkId])
  @@index([originCity, destinationCity])
}

model HubCommissionAgreement {
  id                  String   @id @default(uuid())
  hubId               String
  hub                 Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  handlingFeePerOrder Float    @default(0) // taxa de manuseio físico fixa por pedido
  percentOfFreight    Float? // comissão em % sobre o frete cobrado do cliente
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([hubId])
}

enum LinkCostMode {
  FLAT
  PER_M3
  PER_KG
}

enum CteEmissionJobPhase {
  QUEUED
  EMPRESA_ENSURING
  SUBMITTED
  POLLING
  DOWNLOADING_FILES
  DONE
  FAILED
  PENDING_RECONCILIATION
}

model CteEmissionJob {
  id     String                  @id @default(uuid())
  calcId String
  calc   OrderFreightCalculation @relation(fields: [calcId], references: [id], onDelete: Cascade)

  queueJobId      String?             @unique
  providerDocId   String?             @unique
  phase           CteEmissionJobPhase @default(QUEUED)
  attemptCount    Int                 @default(0)
  maxAttempts     Int                 @default(24)
  lastPolledAt    DateTime?
  nextPollAt      DateTime?
  lastHttpStatus  Int?
  lastError       String?             @db.Text
  pausedForQuota  Boolean             @default(false)
  xmlDownloadedAt DateTime?
  pdfDownloadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calcId])
  @@index([phase, nextPollAt])
}

enum CiotEmissionJobPhase {
  QUEUED
  CADASTROS_ENSURING // Gravar Motorista/Proprietário/Veículo
  SUBMITTED
  POLLING
  DONE
  FAILED
  PENDING_RECONCILIATION
}

// Emissão de CIOT via eFrete é assíncrona (fila) — API externa pode dar timeout, e reenvio
// direto do request HTTP geraria CIOT duplicado (multa ANTT). idOperacaoCliente é a chave
// de idempotência: antes de qualquer POST, o worker consulta se ela já existe no eFrete.
model CiotEmissionJob {
  id         String   @id @default(uuid())
  manifestId String
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  queueJobId                  String?              @unique
  idOperacaoCliente           String               @unique // "CIOT-<manifestId>"
  codigoIdentificacaoOperacao String?              @unique // CIOT retornado pela eFrete
  tipoViagem                  CiotTipoViagem
  // "Carta Frete": valores/impostos/distância digitados pelo Hub/Admin no momento da emissão
  // (não tem lugar fixo no schema do Manifest — é dado pontual da operação de transporte).
  requestData                 Json
  phase                       CiotEmissionJobPhase @default(QUEUED)
  attemptCount                Int                  @default(0)
  maxAttempts                 Int                  @default(24)
  lastPolledAt                DateTime?
  nextPollAt                  DateTime?
  lastHttpStatus              Int?
  lastError                   String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([manifestId])
  @@index([phase, nextPollAt])
}

enum SystemAlertCategory {
  FISCAL_PROVIDER_QUOTA
  FISCAL_PROVIDER_ERROR
  FISCAL_DISTRIBUICAO_NFE_QUOTA
  FISCAL_DISTRIBUICAO_NFE_NOT_SEEDED
  FISCAL_ENCERRAMENTO_PENDENTE
  GENERIC
}

enum SystemAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SystemAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model SystemAlert {
  id       String              @id @default(uuid())
  category SystemAlertCategory
  severity SystemAlertSeverity @default(WARNING)
  status   SystemAlertStatus   @default(OPEN)
  title    String
  message  String              @db.Text
  context  Json?

  createdAt            DateTime  @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?

  @@index([status])
  @@index([category])
}

// ========================================
// NUMERAÇÃO SEQUENCIAL DE PEDIDOS
// ========================================

model OrderSequenceConfig {
  id         String   @id @default("global")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
  updatedBy  String?
}

// ========================================
// DISTRIBUIÇÃO NF-E (ACBr) — varredura de NSU + triagem manual
// ========================================

enum NfeDistribuicaoDocumentoTipo {
  RESUMO // resNFe — resumo do documento (não é o nfeProc completo)
  NFE_PROC // nfeProc — NF-e completa autorizada
  EVENTO // procEventoNFe — evento (cancelamento, CCe, etc.)
  DESCONHECIDO // schema não reconhecido — cai em PENDING_RECONCILIATION pra revisão manual
}

enum NfeDistribuicaoDocumentoStatus {
  DISCOVERED // Descoberto via dist-nsu, ainda não manifestado
  MANIFESTED // Ciência da Operação (evento 210210) confirmada
  READY_FOR_TRIAGE // XML baixado e persistido — pronto pra Hub/Admin decidir
  CONVERTED // Hub/Admin confirmou: virou Demand
  DISCARDED // Hub/Admin confirmou: não é carga nossa, descartado
  FAILED // Erro definitivo (schema desconhecido, chave inválida, etc.)
  PENDING_RECONCILIATION // 429 esgotou tentativas ou 402 — precisa de ação manual/reprocesso
}

model NfeDistribuicaoDocumento {
  id  String @id @default(uuid())
  nsu String // NSU da distribuição em que este documento apareceu

  accessKey    String                       @unique // chave de acesso, 44 dígitos
  tipo         NfeDistribuicaoDocumentoTipo
  cnpjEmitente String // só dígitos — fornecedor/emitente da NF-e
  ambiente     String // homologacao | producao (mesmo domínio de FiscalDistribuicaoCheckpoint)

  fiscalEmitterId String // nosso CNPJ destinatário monitorado
  fiscalEmitter   FiscalEmitter @relation(fields: [fiscalEmitterId], references: [id], onDelete: Restrict)

  resumoRaw Json // payload bruto retornado pela distribuição (schema varia por tipo)

  status          NfeDistribuicaoDocumentoStatus @default(DISCOVERED)
  manifestedAt    DateTime?
  xmlDownloadedAt DateTime?
  xmlStorageKey   String?

  attemptCount   Int     @default(0)
  lastHttpStatus Int?
  lastError      String? @db.Text
  pausedForQuota Boolean @default(false)

  convertedDemandId String?
  convertedDemand   Demand?   @relation(fields: [convertedDemandId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  discardedAt       DateTime?
  discardedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fiscalEmitterId, status])
  @@index([status])
  @@index([cnpjEmitente])
}
