# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tsmex?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Fiscal / CT-e / DC-e / MDF-e / Distribuição DF-e (ACBr API REST)
# Modo simulado (sem ACBr): FISCAL_CTE_PROVIDER_MODE=simulate-authorized
# FISCAL_CTE_ENV: fallback global do host ACBr quando não há emitente no contexto (ex.: MDF-e sem emitente no hub).
# Por emitente, o ambiente em "Emitentes credenciados" define hom.acbr vs prod.acbr.
FISCAL_CTE_ENV="HOMOLOGACAO"
FISCAL_CTE_PROVIDER_MODE="simulate-authorized"
FISCAL_SECRET_KEY="change-me-use-32-bytes-or-64-hex-chars"

# OAuth2 ACBr (https://dev.acbr.api.br) — CT-e, DC-e, MDF-e, distribuição NF-e
ACBR_CLIENT_ID=""
ACBR_CLIENT_SECRET=""
# Opcional: força um único host para todas as chamadas (ignorado quando a requisição usa ambiente por emitente).
# ACBR_API_BASE_URL="https://prod.acbr.api.br"
# Município IBGE fallback quando endereço não traz código (homologação)
# ACBR_FALLBACK_CMUN="3550308"

# Storage privado para logos, documentos e certificados A1
# Apenas desenvolvimento local. Em staging/producao usar endpoint HTTPS publico.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="miniosecret"
S3_BUCKET="tsm-ex-uploads"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="http://localhost:9000"
S3_SIGNED_URL_PUBLIC_HOST="http://localhost:9000"
