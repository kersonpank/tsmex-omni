# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tsmex?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# -----------------------------------------------------------------------------
# Portainer — variáveis usuais da API (mínimo)
# -----------------------------------------------------------------------------
# Obrigatórias típicas deste projeto: DATABASE_URL, JWT_SECRET, NODE_ENV, PORT, CORS_ORIGIN,
# FISCAL_SECRET_KEY, ACBR_CLIENT_ID, ACBR_CLIENT_SECRET, bucket S3 (endpoint, keys, bucket).
#
# Fiscal — onde fica cada coisa:
# - Console ACBr entrega só: ACBR_CLIENT_ID, ACBR_CLIENT_SECRET
# - FISCAL_SECRET_KEY é só da aplicação: criptografa a senha do .pfx no banco (não é senha do certificado)
# - Homologação vs produção (host hom.acbr / prod.acbr): configuração do EMITENTE na UI — não há FISCAL_CTE_ENV
# - Modo SIMULADO (sem ACBr) no código usa autorização fake fixa para testes de tela — não há FISCAL_CTE_PROVIDER_MODE
# - CT-e/DC-e na API exigem cálculo com FiscalEmitter ativo
# -----------------------------------------------------------------------------

FISCAL_SECRET_KEY="change-me-use-32-bytes-or-64-hex-chars"

# OAuth2 ACBr (https://dev.acbr.api.br)
ACBR_CLIENT_ID=""
ACBR_CLIENT_SECRET=""
# Opcional: mesmo host ACBr para tudo quando nenhum ambiente de emitente foi passado (dev); senão padrão hom.acbr.api.br
# ACBR_API_BASE_URL="https://prod.acbr.api.br"
# Município IBGE fallback quando endereço não traz código (homologação)
# ACBR_FALLBACK_CMUN="3550308"

# Storage privado para logos, documentos e certificados A1
# Apenas desenvolvimento local. Em staging/producao usar endpoint HTTPS publico.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="miniosecret"
S3_BUCKET="tsm-ex-uploads"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="http://localhost:9000"
S3_SIGNED_URL_PUBLIC_HOST="http://localhost:9000"
