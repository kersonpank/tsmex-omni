# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tsmex?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Fiscal / CT-e / MDF-e
FISCAL_CTE_ENV="HOMOLOGACAO"
FISCAL_CTE_PROVIDER_MODE="simulate-authorized"
FISCAL_SECRET_KEY="change-me-use-32-bytes-or-64-hex-chars"

# Storage privado para logos, documentos e certificados A1
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="miniosecret"
S3_BUCKET="tsm-ex-uploads"
S3_FORCE_PATH_STYLE="true"
