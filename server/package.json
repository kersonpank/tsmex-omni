{
    "name": "tsm-ex-api",
    "version": "1.0.0",
    "description": "TSM EX Logistics Orchestrator API",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "worker:dev": "tsx watch src/worker.ts",
        "worker": "node dist/worker.js",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test \"src/**/*.test.ts\"",
        "start": "node dist/index.js",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "db:seed:e2e-manifest": "tsx prisma/seed-manifest-e2e.ts",
        "db:migrate-persons": "tsx prisma/migrate-persons.ts",
        "smoke:pr002-intake": "node scripts/smoke-pr002-intake.mjs",
        "audit:nfe-distribution": "tsx src/scripts/auditNfeDistribution.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1032.0",
        "@aws-sdk/s3-request-presigner": "^3.1032.0",
        "@prisma/client": "^6.2.1",
        "@types/morgan": "^1.9.10",
        "axios": "^1.7.9",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.34.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "fast-xml-parser": "^5.9.3",
        "ioredis": "5.10.1",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.1",
        "node-forge": "^1.4.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.10.7",
        "@types/node-forge": "^1.3.11",
        "prisma": "^6.2.1",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
