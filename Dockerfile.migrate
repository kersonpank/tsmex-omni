# Migration and seed service - uses development deps
FROM node:20-alpine

WORKDIR /app

# TCP wait antes do Prisma — no Swarm o migrate pode ser agendado antes do Postgres aceitar conexões
RUN apk add --no-cache netcat-openbsd

# Copy package files
COPY server/package*.json ./

# Install all dependencies (need tsx for seed)
RUN npm ci

# Copy Prisma schema, migrations, seed and entrypoint script
COPY server/prisma ./prisma

# Generate Prisma client
RUN npx prisma generate

# Copy and prepare entrypoint (plain .sh avoids Dockerfile $→$$ parsing issues in CMD exec form)
RUN chmod +x /app/prisma/migrate.sh

# MIGRATE_MODE options:
# - deploy (recommended for staging/prod): prisma migrate deploy
# - push (legacy/dev fallback): prisma db push --accept-data-loss
# Optional: RUN_SEED=true, RUN_MIGRATE_PERSONS=true
CMD ["/app/prisma/migrate.sh"]
