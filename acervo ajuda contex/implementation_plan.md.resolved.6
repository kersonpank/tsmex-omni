## Schema Changes Necessários

### Novo: Opportunity (Pipeline Comercial)

```prisma
model Opportunity {
  id              String   @id @default(uuid())
  sessionId       String   // Conversa do chat
  
  // Status comercial
  stage           OpportunityStage  // QUOTE, REQUESTED, WON, LOST
  
  // Tipo
  type            OpportunityType   // QUOTE_ONLY, TRANSPORT, COLLECTION
  
  // Dados extraídos (podem estar incompletos)
  cpfCnpjSender   String?
  cpfCnpjReceiver String?
  commodity       String?
  nfValue         Float?
  weight          Float?
  volumes         Int?
  dimensions      String?  // "100x50x30 cm"
  
  // Coleta
  needsCollection Boolean  @default(false)
  collectionAddress Json?  // {street, number, city, cep, contact}
  collectionTime  String?
  needsHelper     Boolean  @default(false)
  
  // Cotação (se calculada)
  quotedPrice     Float?
  quoteBreakdown  Json?    // {freight, gris, icms, total}
  
  // Origem → Destino
  origin          String?
  destination     String?
  
  // Conversa
  messagesSnapshot Json[]  // Captura do contexto da conversa
  
  // Se converter em demanda
  demandId        String?  @unique
  demand          Demand?  @relation(fields: [demandId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OpportunityStage {
  QUOTE       // Só perguntou valor
  REQUESTED   // Pediu para fechar
  WON         // Confirmou e virou Demand
  LOST        // Desistiu/não respondeu
}

enum OpportunityType {
  QUOTE_ONLY   // Só quer saber preço
  TRANSPORT    // Quer transportar
  COLLECTION   // Quer coleta
  BOTH         // Quer transporte + coleta
}
```

