##### [MODIFICAR] [geminiService.ts](file:///d:/Kerson%20Company%20Tech/TSM%20EX/TSM%20EX%20JAN%202026/tsm%20ex%20omni/geminiService.ts)

```typescript
// Adicionar função que extrai dados estruturados
export const extractDemandData = async (conversation: Message[]) => {
  const ai = getAI();
  const response = await ai.models.generateContent({
    model: 'gemini-3-flash-preview',
    contents: `Analise esta conversa e extraia os dados da demanda.
    Conversa: ${JSON.stringify(conversation)}
    
    Retorne APENAS se todos os campos obrigatórios estiverem preenchidos.`,
    config: {
      responseMimeType: "application/json",
      responseSchema: {
        type: Type.OBJECT,
        properties: {
          complete: { type: Type.BOOLEAN },
          data: {
            type: Type.OBJECT,
            properties: {
              origin: { type: Type.STRING },
              destination: { type: Type.STRING },
              weight: { type: Type.NUMBER },
              nfValue: { type: Type.NUMBER },
              commodity: { type: Type.STRING },
            }
          },
          missingFields: { type: Type.ARRAY, items: { type: Type.STRING } }
        }
      }
    }
  });
  
  return JSON.parse(response.text || '{}');
};
```

