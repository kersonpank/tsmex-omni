## Proposed Changes

### Database - Prisma Schema

#### [MODIFY] [schema.prisma](file:///d:/Kerson%20Company%20Tech/TSM%20EX/TSM%20EX%20JAN%202026/tsm%20ex%20omni/server/prisma/schema.prisma)

Adicionar modelos para LLM:

```prisma
// ========================================
// LLM CONFIGURATION
// ========================================

model LLMProvider {
  id          String   @id @default(uuid())
  name        String   // "OpenAI", "Google", "Anthropic", "Ollama"
  code        String   @unique // "openai", "gemini", "claude", "ollama"
  baseUrl     String?  // Custom endpoint (for Ollama/self-hosted)
  active      Boolean  @default(true)
  
  models      LLMModel[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LLMModel {
  id            String   @id @default(uuid())
  
  // Provider relationship
  providerId    String
  provider      LLMProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  // Model info
  name          String   // "GPT-4o", "Gemini Pro", "Claude 3.5 Sonnet"
  modelId       String   // "gpt-4o", "gemini-pro", "claude-3-5-sonnet"
  description   String?
  
  // Capabilities
  capabilities  String[] // ["chat", "vision", "function_calling", "json_mode"]
  contextWindow Int      @default(8192) // tokens
  maxOutput     Int      @default(4096)
  
  // Pricing (per 1M tokens)
  inputPrice    Float?   // USD
  outputPrice   Float?   // USD
  
  // Status
  isDefault     Boolean  @default(false) // Default for its capability
  active        Boolean  @default(true)
  
  // Usage tracking
  totalTokens   Int      @default(0)
  totalCalls    Int      @default(0)
  lastUsedAt    DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([providerId, modelId])
}

model LLMApiKey {
  id          String   @id @default(uuid())
  providerId  String
  
  // Encrypted API key
  keyHash     String   // Last 4 chars visible
  encryptedKey String  // AES-256 encrypted
  
  // Metadata
  label       String?  // "Production Key", "Dev Key"
  active      Boolean  @default(true)
  
  // Usage limits
  monthlyLimit  Float?  // USD
  monthlyUsage  Float   @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([providerId])
}
```

